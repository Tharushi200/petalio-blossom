<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_inner"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header with Calendar Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_badge_blush">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:contentDescription="Calendar Icon"
                android:src="@drawable/ic_calendar"
                app:tint="@color/primary_brand" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Floral Reminder"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Never miss an important blooming date"
                android:textColor="@color/primary_brand"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Customize your occasion reminder so fresh highland blooms are prepared in advance."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- 1. Occasion Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReminderTitle"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Occasion Name (e.g. Mom's Birthday)"
        android:textColorHint="@color/text_secondary"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/primary_brand"
        app:boxStrokeWidth="1.2dp"
        app:hintTextColor="@color/primary_brand"
        app:startIconDrawable="@drawable/ic_heart_filled"
        app:startIconTint="@color/primary_brand">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReminderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Occasion Date -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReminderDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Occasion Date (e.g. 28 Oct 2026)"
        android:textColorHint="@color/text_secondary"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/primary_brand"
        app:boxStrokeWidth="1.2dp"
        app:hintTextColor="@color/primary_brand"
        app:startIconDrawable="@drawable/ic_calendar"
        app:startIconTint="@color/primary_brand">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReminderDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Preset Bouquet -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReminderPreset"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Bouquet Preset (e.g. Dutch Crimson Roses)"
        android:textColorHint="@color/text_secondary"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/primary_brand"
        app:boxStrokeWidth="1.2dp"
        app:hintTextColor="@color/primary_brand"
        app:startIconDrawable="@drawable/ic_flower_petal"
        app:startIconTint="@color/primary_brand">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReminderPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelReminder"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary_blossom"
            android:minWidth="90dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveReminder"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_primary_blossom"
            android:minWidth="130dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Save Reminder"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>