<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_botanical_light">

    <!-- Top Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarTracking"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBackTracking"
            android:layout_width="40dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTrackingHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/btnBackTracking"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:gravity="center_vertical"
            android:text="Order —"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarTracking"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Delivery Status Tracker matching wireframe -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_container"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:text="Delivery Status"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrackingStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:background="@drawable/bg_badge_status"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:text="On the Way"
                            android:textColor="@color/primary_forest"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Stepper Bar matching wireframe -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Step 1: Placed -->
                        <View
                            android:id="@+id/stepPlacedDotTrack"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:backgroundTint="@color/primary_forest" />

                        <View
                            android:id="@+id/stepLine1Track"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:background="@color/divider_color" />

                        <!-- Step 2: Preparing -->
                        <View
                            android:id="@+id/stepPreparingDotTrack"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:backgroundTint="@color/divider_color" />

                        <View
                            android:id="@+id/stepLine2Track"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:background="@color/divider_color" />

                        <!-- Step 3: Dispatched -->
                        <View
                            android:id="@+id/stepDispatchedDotTrack"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:backgroundTint="@color/divider_color" />

                        <View
                            android:id="@+id/stepLine3Track"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:background="@color/divider_color" />

                        <!-- Step 4: Delivered -->
                        <View
                            android:id="@+id/stepDeliveredDotTrack"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_stepper_btn"
                            android:backgroundTint="@color/divider_color" />
                    </LinearLayout>

                    <!-- Stepper labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/stepPlacedTextTrack"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Placed"
                            android:textColor="@color/primary_forest"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/stepPreparingTextTrack"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Preparing"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/stepDispatchedTextTrack"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Dispatched"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/stepDeliveredTextTrack"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Delivered"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTrackingExpectedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Loading delivery status..."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Driver Details & Contact -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_container"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery Driver"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrackingDriverDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Awaiting driver assignment"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Button: Rate & Review Order (Links to O5) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRateFromTracking"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_outline_pink_button"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:stateListAnimator="@null"
                android:text="Rate &amp; Review Delivery"
                android:textAllCaps="false"
                android:textColor="@color/accent_blossom_pink"
                android:textSize="14sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_star_rate"
                app:drawableTint="@color/accent_blossom_pink" />

        </LinearLayout>
    </ScrollView>

    <!-- Subtle 1dp #F0DCE2 Top Divider Line above Bottom Navigation -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        android:background="@color/border_subtle" />

    <!-- Modern Bottom Navigation Bar Matching Wireframe & CustomerMainActivity -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavCard"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardBackgroundColor="@color/card_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Tab 1: Browse -->
            <LinearLayout
                android:id="@+id/navTabBrowse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavBrowse"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_browse"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvNavBrowse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Browse"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Tab 2: Cart -->
            <LinearLayout
                android:id="@+id/navTabCart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/ivNavCart"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@drawable/ic_nav_cart"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/badgeNavCart"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:minWidth="20dp"
                        android:layout_gravity="top|end"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-6dp"
                        android:background="@drawable/bg_badge_cart_count"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text=""
                        android:textColor="@color/text_white"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNavCart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Cart"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Tab 3: Orders (Active) -->
            <LinearLayout
                android:id="@+id/navTabOrders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavOrders"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_orders"
                    app:tint="@color/primary_forest" />

                <TextView
                    android:id="@+id/tvNavOrders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Orders"
                    android:textColor="@color/primary_forest"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 4: Profile -->
            <LinearLayout
                android:id="@+id/navTabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvNavProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Profile"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="normal" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
